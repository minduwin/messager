<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title>Document</title>
</head>
<body>
    <div class="headBoard">
        <h1>Form</h1>
    </div>
    <form method="POST" action="/new" class="mainForm">
        <div class="formInput">
            <input type="text" name="alias" id="alias" placeholder="Name" size="50">
            <textarea name="info" rows="5" placeholder="Add a message..."></textarea>
        <div class="submitBtn">
            <button type="submit">Submit</button>
        </div>
    </form>
    <div class="backHome">
        <a href="/">Back to Home</a>
    </div>
</body>
</html>