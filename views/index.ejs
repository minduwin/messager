<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title>Message Board</title>
</head>
<body>
    <div class="headBoard">
        <h1>Message Board</h1>
    </div>
    <div class="mainBoard">
        <% messages.forEach((msg, index) => { %>
            <li class="message">
                <div class="msgText">
                    <div class="mainText">
                        <p><%= msg.username %></p>
                        <span>
                            <%= msg.added.toLocaleDateString('en-US', 
                            { month: 'short', day: '2-digit' }) %>
                        </span>
                    </div>
                    <div class="mainMessage">
                        <p><%= msg.text %></p>
                        <div class="openBtn" title="Open Message">
                            <a href="/messages/<%= msg.id %>">
                                <button>Open</button>
                            </a>
                        </div>
                    </div>
                </div>
            </li>
        <% }) %>
    </div>
    <div class="addButton">
        <a href="/new">
            <button>Add Message</button>
        </a>
    </div>
</body>
</html>